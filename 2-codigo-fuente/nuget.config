<?xml version="1.0" encoding="utf-8"?>
<!-- Compilación sin internet: usa solo los paquetes incluidos en ./paquetes-nuget -->
<configuration>
  <config>
    <add key="globalPackagesFolder" value="paquetes-nuget" />
  </config>
  <packageSources>
    <clear />
    <add key="paquetes-locales" value="paquetes-nuget" />
  </packageSources>
</configuration>
